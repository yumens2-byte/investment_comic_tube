# Runtime: dry-run | review | publish
APP_MODE=dry-run
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/app.db
ARTIFACT_DIR=artifacts

# Market data
DATA_PROVIDER=yfinance
MARKET_TIMEZONE=America/New_York

# Gemini (not wired in the current prototype)
GEMINI_API_KEY=
GEMINI_MODEL=

# YouTube OAuth. Keep production values in a secret manager, never in Git.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_CATEGORY_ID=27
